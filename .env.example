# Шаблон настроек. Реальные значения — только в .env (он не попадает в git).
# Разделы — по процессам: какой сервис какие переменные читает.
# [план] — переменная заведена заранее, код её пока не читает.


# ───────── 1. Общее: нужно всем сервисам ─────────

# Подключение к Postgres (для docker compose менять не нужно)
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
# Пароль Postgres — только для docker-compose.prod.yml (VPS)
DB_PASSWORD=

# LLM, OpenAI-совместимый API. Читают: dialog, broadcast, nightly (build_kb), перенос постов
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Рабочий день владельца по Москве. Читают: dialog (ночной режим), nightly (запуск в OWNER_DAY_END)
OWNER_UTC_OFFSET=3
OWNER_DAY_START=8
OWNER_DAY_END=20


# ───────── 2. Avito, аккаунт 1 (GameNonStop) ─────────
# Читают: avito_gateway, export, import_history

# Приложение на https://developers.avito.ru
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# ID чатов через запятую, где бот отвечает, пока не включён режим «все чаты» (пусто = ни одного).
# Читается при первом запуске, дальше белый список живёт в БД
AVITO_TEST_CHAT_IDS=
# Интервал опроса Avito, секунд
GATEWAY_POLL_SECONDS=3
# 1 — режим тестов: бот отвечает сразу (без паузы 7–12 с, опрос Avito раз в 1 с). В бою оставить пустым
REPLY_INSTANT=


# ───────── 3. Сообщество VK №1: алерты и управление по аккаунту 1 ─────────
# Читают: owner_bot (кнопки, прайс, рассылки), dialog (алерты), nightly (ошибки админу)

# ID сообщества и его ключ доступа (Управление → Работа с API; права: сообщения, фото)
VK_GROUP_ID=
VK_GROUP_TOKEN=
# VK ID пользователей через запятую: владелец и админ. Только для первого запуска, дальше — таблица owner.subscribers
VK_OWNER_IDS=
VK_ADMIN_IDS=


# ───────── 4. Оплата и выдача (dialog, shared/sales.py) ─────────

# Реквизиты СБП, которые бот отправляет клиенту (банк выбирается по кругу из sales.banks)
PAY_PHONE=
PAY_RECIPIENT=
# Кругов по банкам (карты) в сутки; дальше оплата идёт на ИП (если включена), иначе — предупреждение в VK
PAY_ROUNDS=4
# 1 — после оплаты выдавать аккаунт со склада (sales.accounts) автоматически; пусто — владелец подключает сам
SALES_AUTO_ISSUE=

# Оплата на ИП — СБП через платёжный шлюз Альфа-Банка (shared/alfa.py): бот сам видит оплату и выдаёт, хоть ночью.
# Сроки до 6 мес — на ИП, от 8 мес — на карты по кругу. Логин с окончанием -api и его пароль (письмо банка);
# проверка пары: python scripts/alfa_check.py
ALFA_USER=
ALFA_PASSWORD=
# Адрес шлюза: боевой https://pay.alfabank.ru (по умолчанию), тестовый https://alfa.rbsuat.com (своя пара)
ALFA_URL=
# Включает и выключает владелец в VK кнопкой «💳 Оплата на ИП» (по умолчанию выкл). Тестовые клиенты
# (avito user id через запятую) и чаты (u2i-…) — всегда ИП на ALFA_TEST_AMOUNT ₽, склад и база клиентов не трогаются
ALFA_TEST_CLIENTS=
ALFA_TEST_CHATS=
ALFA_TEST_AMOUNT=10
# Куда вернуть клиента после оплаты на платёжной странице
ALFA_RETURN_URL=


# ───────── 5. Автопостинг в VK (services/content, scripts/vk_copy_posts.py) ─────────

# Какие площадки ведёт этот экземпляр: vk, tg или пусто = обе. На разных серверах: РФ — vk, зарубежный — tg
CONTENT_TARGETS=
# Только на сервере: какие сервисы поднимает scripts/deploy.sh (через пробел, например: db content); пусто = все
DEPLOY_SERVICES=

# Паблики-источники VK через запятую (короткие имена). Пусто = xbox1store. Только для первого запуска:
# дальше список живёт в БД (content.sources) и правится кнопкой «📚 Источники» в сообществе согласования
CONTENT_VK_SOURCES=
# Сервисный ключ приложения VK — читает открытые стены источников (wall.get)
VK_SERVICE_KEY=
# Ключ публичного сообщества, куда постим (PREMIUM MARKET) — публикует пост (wall.post)
VK_POST_TOKEN=
# ID приложения VK, через которое выдаётся токен пользователя, и запрашиваемые права.
# Рабочая связка с 06.10: мини-приложение «Reader» 54801207, права wall,photos (токен на 24 ч).
# (Kate 2685278 с offline с 05.10 под Flood control у целевого аккаунта)
VK_APP_ID=
VK_SCOPE=
# Защищённый ключ этого приложения (настройки приложения). С ним бот просит адрес с одноразовым кодом и сам
# получает по нему токен: токен мини-приложения привязан к IP, где его выдали, а нужен он на сервере
VK_APP_SECRET=
# Аккаунт-администратор сообщества, чей токен принимаем (целевой аккаунт); токен другого аккаунта бот отклонит
VK_USER_ID=
# Альбом сообщества для фото постов (id из ссылки vk.com/album-<группа>_<id>): фото в нём принадлежат сообществу
# и прикрепляются к записи ключа сообщества. Пусто — старый способ (фото в скрытый альбом пользователя)
VK_ALBUM_ID=
# 1 — запись на стене создаёт сам токен пользователя (нужен токен Standalone-приложения); пусто — ключ сообщества
VK_USER_POSTS=
# Токен пользователя для ручных скриптов на ПК (scripts/vk_copy_posts.py). Сервис content токен держит в БД:
# каждое утро просит в чате согласования открыть ссылку, нажать «Разрешить» и прислать адрес страницы.
# На ПК: python -m services.content.vk_token --paste (адрес из буфера обмена)
VK_USER_TOKEN=
VK_USER_TOKEN_EXPIRES=
# Браузер для окна выдачи токена: chrome (по умолчанию) или msedge. Вход в VK хранится в data/vk_browser*
VK_BROWSER=


# ───────── 6. Сообщество VK №2: согласование автопостинга (services/content) ─────────
# Сюда бот присылает посты на «Опубликовать / Пропустить». Согласует любой участник сообщества,
# написавший ему. В Long Poll API сообщества должно быть включено «Входящее сообщение»

VK_CONTENT_GROUP_ID=
VK_CONTENT_GROUP_TOKEN=
# Telegram: токен бота (@BotFather), бот — администратор канала с правом публикации; канал — @имя или числовой ID
TG_BOT_TOKEN=
TG_CHANNEL_ID=
# Открытые Telegram-каналы-источники через запятую (имена без @); читаются через t.me/s/<имя>.
# Только для первого запуска, дальше — «📚 Источники»
CONTENT_TG_SOURCES=
# [план] Telegram: чтение закрытых каналов и видео (https://my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=


# ───────── 7. [план] Avito, аккаунт 2 и сообщество VK №3: алерты по нему ─────────

AVITO2_CLIENT_ID=
AVITO2_CLIENT_SECRET=
AVITO2_TEST_CHAT_IDS=
VK2_GROUP_ID=
VK2_GROUP_TOKEN=
